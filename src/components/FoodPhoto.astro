---
/**
 * Responsive owner-supplied food photo (public/img/food/<id>-{480,900,1600}.webp, 4:3).
 * Width/height are declared so nothing shifts while loading.
 */
import { withBase } from '@lib/paths';
import { photos } from '@data/photos';
export interface Props { id: string; sizes?: string; eager?: boolean; class?: string; alt?: string }
const { id, sizes = '(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 92vw', eager = false, class: cls, alt } = Astro.props;
const p = photos[id];
if (!p) throw new Error(`Unknown photo id "${id}"`);
const src = (w: number) => withBase(`/img/food/${id}-${w}.webp`);
---
<img
  class={cls}
  src={src(900)}
  srcset={`${src(480)} 480w, ${src(900)} 900w, ${src(1600)} 1600w`}
  sizes={sizes}
  width="1600"
  height="1200"
  alt={alt ?? p.alt}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>
