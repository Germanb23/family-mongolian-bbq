---
import { withBase, isCurrentPath } from '@lib/paths';
import { business } from '@data/business';
import Wordmark from './Wordmark.astro';
import Icon from './Icons.astro';
const path = Astro.url.pathname;
const home = isCurrentPath(path, '/');
// On the home page the sections are anchors; elsewhere they point back to the home sections.
const link = (hash: string) => (home ? `#${hash}` : withBase(`/#${hash}`));
const nav = [
  { label: 'Menu', href: withBase('/menu/'), current: isCurrentPath(path, '/menu/') },
  { label: 'Experience', href: link('experience'), current: false },
  { label: 'The Grill', href: link('grill'), current: false },
  { label: 'Gallery', href: link('gallery'), current: false },
  { label: 'Visit', href: link('visit'), current: false },
];
---
<header class="site-header" data-header>
  <div class="container site-header__row">
    <a class="site-header__brand" href={withBase('/')} aria-label={`${business.name} — home`}>
      <Wordmark size="sm" />
    </a>
    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <Icon name="menu" /><span>Menu</span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Primary" data-nav>
      <ul class="site-nav__list">
        {nav.map((n) => (
          <li><a class="site-nav__link" href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="site-nav__call"><a class="site-nav__link" href={`tel:${business.phone.e164}`}><Icon name="phone" /> {business.phone.display}</a></li>
      </ul>
    </nav>
    <a class="btn btn--primary btn--sm site-header__order" href={business.order.doordash.url} target="_blank" rel="noopener">
      <Icon name="bag" /> Order Online
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(250 248 244 / 0.92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgb(220 213 201 / 0.7);
  }
  .site-header__row { display: flex; align-items: center; gap: 1rem; min-height: 4.25rem; }
  .site-header__brand { text-decoration: none; margin-right: auto; display: inline-flex; padding: 0.35rem 0; }
  .site-header__toggle { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; padding: 0.4rem 0.7rem; border-radius: var(--radius); font-weight: 650; }
  .site-header__toggle svg { width: 1.35rem; height: 1.35rem; }
  .site-nav__list { display: flex; gap: clamp(0.25rem, 1.2vw, 1rem); align-items: center; }
  .site-nav__link { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; padding: 0.4rem 0.75rem; border-radius: var(--radius); font-weight: 600; text-decoration: none; position: relative; }
  .site-nav__link svg { width: 1.05rem; height: 1.05rem; }
  .site-nav__link:hover { color: var(--c-red); }
  .site-nav__link[aria-current='page']::after { content: ''; position: absolute; left: 0.75rem; right: 0.75rem; bottom: 0.3rem; height: 3px; background: var(--c-amber); border-radius: 2px; }
  .site-nav__call { display: none; }

  @media (min-width: 60rem) {
    .site-header__toggle { display: none; }
    .site-nav__call { display: list-item; }
  }
  @media (max-width: 59.99rem) {
    .site-nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--c-marble); border-bottom: 1px solid var(--c-line); box-shadow: var(--shadow); }
    .site-nav.is-open { display: block; }
    .site-nav__list { flex-direction: column; align-items: stretch; padding: 0.5rem var(--gutter) 0.9rem; gap: 0; }
    .site-nav__link { min-height: 3rem; font-size: 1.05rem; }
    .site-nav__call { display: list-item; border-top: 1px solid var(--c-line); margin-top: 0.4rem; padding-top: 0.4rem; }
    .site-header__order span { display: none; }
  }
  .site-header__order { white-space: nowrap; }
  @media (max-width: 30rem) { .site-header__order { padding-inline: 0.85rem; font-size: 0.9rem; min-height: 2.6rem; } .site-header__toggle span { display: none; } }
</style>

<script>
  const initNav = () => {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!toggle || !nav || toggle.dataset.ready) return;
    toggle.dataset.ready = '1';
    const set = (open: boolean) => { nav.classList.toggle('is-open', open); toggle.setAttribute('aria-expanded', String(open)); };
    toggle.addEventListener('click', () => set(!nav.classList.contains('is-open')));
    nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('is-open')) { set(false); toggle.focus(); } });
    document.addEventListener('click', (e) => { if (!nav.contains(e.target as Node) && !toggle.contains(e.target as Node)) set(false); });
  };
  document.addEventListener('astro:page-load', initNav);
</script>
