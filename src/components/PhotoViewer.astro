---
/**
 * Expanded-image viewer — one native <dialog> per page, shared by the gallery and the menu thumbnails.
 * Openers carry data-viewer-src / -alt / -caption and an optional data-viewer-group; items in the same
 * group get Previous / Next (buttons + arrow keys). Escape, backdrop and Close all dismiss; focus returns
 * to the opener. Images are shown at their natural proportions (object-fit: contain).
 */
import Icon from './Icons.astro';
---
<dialog class="viewer" id="photo-viewer" aria-label="Expanded photo">
  <div class="viewer__inner">
    <button class="viewer__btn viewer__close" type="button" data-viewer-close aria-label="Close"><Icon name="close" /></button>
    <button class="viewer__btn viewer__nav viewer__nav--prev" type="button" data-viewer-prev aria-label="Previous photo" hidden><Icon name="arrow" /></button>
    <figure class="viewer__figure">
      <img data-viewer-img alt="" decoding="async" />
      <figcaption class="viewer__caption" data-viewer-caption></figcaption>
    </figure>
    <button class="viewer__btn viewer__nav viewer__nav--next" type="button" data-viewer-next aria-label="Next photo" hidden><Icon name="arrow" /></button>
    <p class="viewer__count small" data-viewer-count aria-live="polite"></p>
  </div>
</dialog>

<style>
  .viewer { border: 0; padding: 0; background: transparent; width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; }
  .viewer::backdrop { background: rgb(19 38 74 / 0.88); }
  .viewer__inner { position: relative; width: 100%; height: 100%; display: grid; place-items: center; padding: clamp(0.75rem, 3vw, 2rem); }
  .viewer__figure { margin: 0; display: grid; gap: 0.6rem; justify-items: center; max-width: 100%; max-height: 100%; }
  .viewer__figure img { max-width: min(100%, 90vw); max-height: calc(100dvh - 7rem); width: auto; height: auto; object-fit: contain; border-radius: var(--radius-lg); background: var(--c-marble-2); box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7); }
  .viewer__caption { color: var(--c-white); font-weight: 600; text-align: center; max-width: 60ch; text-wrap: balance; }
  .viewer__btn { position: absolute; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; background: rgb(250 248 244 / 0.94); color: var(--c-ink); box-shadow: 0 8px 20px -10px rgb(0 0 0 / 0.6); }
  .viewer__btn svg { width: 1.25rem; height: 1.25rem; }
  .viewer__btn:hover { background: var(--c-white); }
  .viewer__btn:focus-visible { outline: 3px solid var(--c-amber); outline-offset: 3px; }
  .viewer__close { top: 0.75rem; right: 0.75rem; }
  .viewer__nav { top: 50%; transform: translateY(-50%); }
  .viewer__nav--prev { left: 0.75rem; }
  .viewer__nav--prev svg { transform: rotate(180deg); }
  .viewer__nav--next { right: 0.75rem; }
  .viewer__count { position: absolute; bottom: 0.75rem; left: 50%; transform: translateX(-50%); color: #c9d2e4; margin: 0; }
  .viewer[open] { animation: viewer-in 200ms var(--ease); }
  @keyframes viewer-in { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .viewer[open] { animation: none; } }
  @media (max-width: 40rem) { .viewer__nav { top: auto; bottom: 2.75rem; transform: none; } }
</style>

<script>
  const initViewer = () => {
    const dlg = document.getElementById('photo-viewer') as HTMLDialogElement | null;
    if (!dlg || dlg.dataset.ready || typeof dlg.showModal !== 'function') return;
    dlg.dataset.ready = '1';
    const img = dlg.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-viewer-caption]')!;
    const count = dlg.querySelector<HTMLElement>('[data-viewer-count]')!;
    const prev = dlg.querySelector<HTMLButtonElement>('[data-viewer-prev]')!;
    const next = dlg.querySelector<HTMLButtonElement>('[data-viewer-next]')!;
    const openers = Array.from(document.querySelectorAll<HTMLElement>('[data-viewer-src]'));
    let group: HTMLElement[] = []; let index = 0; let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + group.length) % group.length;
      const el = group[index];
      img.src = el.dataset.viewerSrc || ''; img.alt = el.dataset.viewerAlt || '';
      cap.textContent = el.dataset.viewerCaption || ''; cap.hidden = !el.dataset.viewerCaption;
      const multi = group.length > 1;
      prev.hidden = next.hidden = !multi;
      count.textContent = multi ? `${index + 1} of ${group.length}` : '';
      // Warm the neighbours so Next/Previous feel instant.
      if (multi) [group[(index + 1) % group.length], group[(index - 1 + group.length) % group.length]].forEach((n) => { const p = new Image(); p.src = n.dataset.viewerSrc || ''; });
    };
    openers.forEach((el) => el.addEventListener('click', (e) => {
      e.preventDefault();
      opener = el;
      const g = el.dataset.viewerGroup;
      group = g ? openers.filter((o) => o.dataset.viewerGroup === g) : [el];
      show(group.indexOf(el));
      dlg.showModal();
      dlg.querySelector<HTMLButtonElement>('[data-viewer-close]')?.focus();
    }));
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' && group.length > 1) { e.preventDefault(); show(index + 1); }
      if (e.key === 'ArrowLeft' && group.length > 1) { e.preventDefault(); show(index - 1); }
    });
    dlg.querySelector('[data-viewer-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target === dlg.firstElementChild) dlg.close(); });
    dlg.addEventListener('close', () => { img.removeAttribute('src'); opener?.focus(); });
  };
  document.addEventListener('astro:page-load', initViewer);
</script>
